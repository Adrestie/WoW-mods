{
  "format": "wow-mods-installer/1",
  "module": "mod-stellar-tarot",
  "title": "Stellar Tarot",
  "signature": ["src/stellar_tarot_loader.cpp", "src/stellar_tarot_scripts.cpp"],
  "exclude_from_sources": ["data/art", "data/dbc", "data/lua", "Backups"],
  "configuration": {
    "file": "mod-stellar-tarot.conf",
    "template": "conf/mod-stellar-tarot.conf.dist"
  },
  "lua": {
    "folder": "StellarTarot",
    "sources": ["data/lua/StellarTarot"]
  },
  "shared": [
    {
      "folder": "Workbench",
      "source": "data/lua/Workbench",
      "version_file": "VERSION",
      "provider_mark": "Workbench.Register(",
      "database": {
        "world": {
          "rows": [
            { "table": "gameobject", "where": "id = 810000" },
            { "table": "gameobject_template_locale", "where": "entry = 810000" },
            { "table": "gameobject_template", "where": "entry = 810000" }
          ]
        }
      }
    }
  ],
  "dbc": [
    { "file": "Spell.dbc", "fields": 234, "text_fields": [[136, 151], [153, 168], [170, 185], [187, 202]],
      "client": "data/dbc/stellartarot_Spell.dbc" },
    { "file": "Item.dbc", "fields": 8, "client": "data/dbc/stellartarot_Item.dbc" },
    { "file": "SpellDuration.dbc", "fields": 4, "client": "data/dbc/stellartarot_SpellDuration.dbc" },
    { "file": "SpellIcon.dbc", "fields": 2, "text_fields": [1], "client": "data/dbc/stellartarot_SpellIcon.dbc" }
  ],
  "game_files": {
    "sources": ["data/art"],
    "owned_folders": ["Interface/mod-Tarot"]
  },
  "database": {
    "characters": {
      "tables": ["mod_stellar_tarot_account_card", "mod_stellar_tarot_account_board",
                 "mod_stellar_tarot_character_board", "mod_stellar_tarot_character_cell",
                 "mod_stellar_tarot_preset", "mod_stellar_tarot_preset_cell"],
      "rows": [
        { "table": "character_spell", "where": "spell IN ({ids:Spell.dbc})" },
        { "table": "character_spell_cooldown", "where": "spell IN ({ids:Spell.dbc})" },
        { "table": "character_aura", "where": "spell IN ({ids:Spell.dbc})" },
        { "table": "character_action", "where": "type = 0 AND action IN ({ids:Spell.dbc})" },
        { "table": "updates", "where": "name IN ({sql_files:characters})" }
      ]
    },
    "world": {
      "tables": ["mod_stellar_tarot_card", "mod_stellar_tarot_card_locale", "mod_stellar_tarot_script",
                 "mod_stellar_tarot_tag", "mod_stellar_tarot_tag_locale", "mod_stellar_tarot_board",
                 "mod_stellar_tarot_board_line", "mod_stellar_tarot_source", "mod_stellar_tarot_loot_pool"],
      "rows": [
        { "table": "module_string", "where": "module = 'mod-stellar-tarot'" },
        { "table": "module_string_locale", "where": "module = 'mod-stellar-tarot'" },
        { "table": "item_template", "where": "entry BETWEEN 87000 AND 88999" },
        { "table": "item_template_locale", "where": "ID BETWEEN 87000 AND 88999" },
        { "table": "item_dbc", "where": "ID BETWEEN 87000 AND 88999" },
        { "table": "item_loot_template", "where": "Entry BETWEEN 87000 AND 88999" },
        { "table": "spell_dbc", "where": "ID BETWEEN 87000 AND 88999" },
        { "table": "spellduration_dbc", "where": "ID BETWEEN 87000 AND 88999" },
        { "table": "spell_proc_event", "where": "entry BETWEEN 87000 AND 88999" },
        { "table": "spell_proc", "where": "ABS(SpellId) BETWEEN 87000 AND 88999" },
        { "table": "spell_linked_spell", "where": "ABS(spell_trigger) BETWEEN 87000 AND 88999" },
        { "table": "spell_script_names", "where": "spell_id BETWEEN 87000 AND 88999" },
        { "table": "creature", "where": "id BETWEEN 87000 AND 88999" },
        { "table": "creature_template_model", "where": "CreatureID BETWEEN 87000 AND 88999" },
        { "table": "creature_template", "where": "entry BETWEEN 87000 AND 88999" },
        { "table": "command", "where": "name = 'tarot' OR name LIKE 'tarot %'" },
        { "table": "updates", "where": "name IN ({sql_files:world})" }
      ]
    }
  }
}
