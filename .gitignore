__pycache__/
*.pyc

# What the layout editor writes while a server is running. The one layout the
# module ships is tracked; anything else is that server's own work.
data/lua/SphereGrid/editor/layouts/*
!data/lua/SphereGrid/editor/layouts/common.xml
!data/lua/SphereGrid/editor/layouts/index.txt

# What the installer keeps aside when it runs from here.
Backups/

# The author's own maps from the origin server's names to the module's: they
# name that server, and mean nothing anywhere else.
tools/local/
