@@ -2208,6 +2213,21 @@ bool DungeonClearDisableOnDeathAction::Execute(Event /*event*/)
 
 bool DungeonClearDisableOnClearedAction::Execute(Event /*event*/)
 {
+    // Papota : donjon termine -> points de spherier (bareme papota_sphere_
+    // point_source, source donjon_termine, par carte, difficulte et palier
+    // d'extension — SpherierMgr::PointsPourInstance) pour les joueurs
+    // humains presents dans l'instance — self-bots compris, le perso en
+    // autopilote appartient au joueur. AVANT DisableDungeonClear : DcRun est
+    // encore arme, cette action ne s'execute donc qu'une fois par run (le
+    // trigger exige un terminal driver, que le Reset du funnel desarme).
+    // Appel qualifie obligatoire : voir l'en-tete de DcPlayerbotCompat.h.
+    if (Group* group = bot ? bot->GetGroup() : nullptr)
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+            if (Player* member = ref->GetSource(); member
+                && member->GetMapId() == bot->GetMapId()
+                && DcPlayerbotCompat::IsHumanControlled(member))
+                sSpherierPlayerMgr->CrediterInstance(member, "donjon_termine", bot->GetMap());
+
     DisableDungeonClear(RunOwnerAI(bot, botAI), DcActionShared::kReasonAllCleared);
     return true;
 }
