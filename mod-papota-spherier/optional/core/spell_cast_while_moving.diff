+// PAPOTA (2026-09-02) : l'Ascendance du chaman (8600062) laisse lancer en
+// marchant l'Eclair, la Chaine d'eclairs et l'Explosion de lave. Rien dans
+// le DBC ne sait le dire POUR UN SEUL JOUEUR : le refus tient aux deux
+// controles de mouvement ci-dessous, qui ne regardent que le sort. Les
+// sorts sont nommes par leur FAMILLE et leur masque, pas par leur rang :
+// tous les rangs en beneficient sans liste a tenir.
+static bool PapotaCasteEnMarchant(Unit const* lanceur, SpellInfo const* info)
+{
+    if (!lanceur || !info)
+        return false;
+
+    // LE CHAMAN sous Ascendance (8600062). Releve 2026-09-02 : Eclair 0x1,
+    // Chaine d'eclairs 0x2 (mot 0) et Explosion de lave 0x1000 (mot 1).
+    if (info->SpellFamilyName == SPELLFAMILY_SHAMAN)
+        return lanceur->HasAura(8600062)
+            && ((info->SpellFamilyFlags[0] & 0x3)
+                || (info->SpellFamilyFlags[1] & 0x1000));
+
+    // LE DEMONISTE sous Cataclysme (8610012, l'aura a deux charges). Ses deux
+    // prochains Feu de l'ame (0x80) et Trait du Chaos (0x20000, mot 1) sont
+    // INSTANTANES — le modificateur ramene leur incantation a zero — mais le
+    // client refuse quand meme de les ouvrir en marchant : il lit le bit
+    // d'InterruptFlags, pas la duree reelle. Releve en jeu le 2026-09-03.
+    if (info->SpellFamilyName == SPELLFAMILY_WARLOCK)
+        return lanceur->HasAura(8610012)
+            && (info->SpellFamilyFlags[1] & 0x20080);
+
+    return false;
+}
