+        {
+            for (uint8 i = INVENTORY_SLOT_ITEM_START; i < INVENTORY_SLOT_ITEM_END; ++i)
+            {
+                Item* pItem = player->GetItemByPos(INVENTORY_SLOT_BAG_0, i);
+                if (pItem && pItem->GetEntry() == itemId)
+                {
+                    item = pItem;
+                    break;
+                }
+            }
+        }
+
+        if (!item)
+        {
+            return true;
+        }
