+                    for (uint32 j = 0; j < pBag->GetBagSize(); ++j)
+                    {
+                        Item* pItem = pBag->GetItemByPos(j);
+                        if (pItem && pItem->GetEntry() == itemId)
+                        {
+                            item = pItem;
+                            break;
+                        }
+                    }
+                }
+                if (item) break;
+            }
+        }
+
+        // Parcourir l'inventaire principal
