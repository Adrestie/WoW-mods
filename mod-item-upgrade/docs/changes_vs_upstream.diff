-    if (!GetBoolConfig(CONFIG_ITEM_UPGRADE_WEAPON_DAMAGE))
-        return std::make_pair(minDamage, maxDamage);
-
-    if (!item)
-        return std::make_pair(minDamage, maxDamage);
